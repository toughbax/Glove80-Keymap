/* Custom Device-tree */

#include <dt-bindings/zmk/rgb_colors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define NUMBERS 2
#define SYMBOLS 3
#define MOUSE 6
#define MOUSEFAST 7
#define MOUSESLOW 8
#define NVIM 13
#define GRN 0x78ff78 //light green
#define RED 0xff0000 //red
#define YLW 0xf8bb00 //orange-yellow
#define BLU 0x00e2ff //teal
#define PUR 0xd451ff //pale purple

/*
 *    RGB MAPS
*/
/* Custom Device-tree */
/* Empty underglow layer definition (for copy-paste)
        mylayer {
            bindings = <
_____ _____ _____ _____ _____                                                            _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____ _____ _____ _____            _____ _____ _____ _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____       _____ _____ _____            _____ _____ _____       _____ _____ _____ _____ _____
        >;
            layer-id = <LAYER_Name>;
        };
*/

#define RGB_AZURE     0x99F5FF // #99F5FF
#define RGB_BLACK     0x000000 // #000000
#define RGB_BLUE      0x0000FF // #0000FF
#define RGB_CHARTRSE  0x80FF00 // #80FF00
#define RGB_CORAL     0xFF7C4D // #FF7C4D
#define RGB_CYAN      0x00FFFF // #00FFFF
#define RGB_GOLD      0xFFD900 // #FFD900
#define RGB_GOLDNROD  0xD9A521 // #D9A521
#define RGB_GREEN     0x00FF00 // #00FF00
#define RGB_MAGENTA   0xFF00FF // #FF00FF
#define RGB_ORANGE    0xFF8000 // #FF8000
#define RGB_PINK      0xFF80BF // #FF80BF
#define RGB_PURPLE    0x7A00FF // #7A00FF
#define RGB_RED       0xFF0000 // #FF0000
#define RGB_SPRINGRN  0x00FF80 // #00FF80
#define RGB_TEAL      0x008080 // #008080
#define RGB_TURQUOIS  0x476E6A // #476E6A
#define RGB_WHITE     0xFFFFFF // #FFFFFF
#define RGB_YELLOW    0xFFFF00 // #FFFF00
#define AZURE         &ug RGB_AZURE
#define BLACK         &ug RGB_BLACK
#define BLUE_         &ug RGB_BLUE
#define CHART         &ug RGB_CHARTRSE
#define CORAL         &ug RGB_CORAL
#define CYAN_         &ug RGB_CYAN
#define GOLD_         &ug RGB_GOLD
#define GOLDN         &ug RGB_GOLDNROD
#define GREEN         &ug RGB_GREEN
#define MGNTA         &ug RGB_MAGENTA
#define ORANG         &ug RGB_ORANGE
#define PINK_         &ug RGB_PINK
#define PURPL         &ug RGB_PURPLE
#define RED__         &ug RGB_RED
#define SPRIN         &ug RGB_SPRINGRN
#define TEAL_         &ug RGB_TEAL
#define TURQU         &ug RGB_TURQUOIS
#define WHITE         &ug RGB_WHITE
#define YELLW         &ug RGB_YELLOW
#define _____         &ug ___

/ {
    underglow-layer {
        compatible = "zmk,underglow-layer";

        numbers {
            bindings = <
_____ _____ _____ _____ _____                                                            _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                SPRIN SPRIN SPRIN _____ _____ _____
_____ CHART CHART _____ CORAL _____                                                WHITE TEAL_ TEAL_ TEAL_ SPRIN _____
_____ GOLDN GOLDN GOLDN GOLDN _____                                                WHITE TEAL_ TEAL_ TEAL_ SPRIN _____
_____ _____ _____ _____ _____ _____ _____ _____ _____            _____ _____ _____ WHITE TEAL_ TEAL_ TEAL_ CORAL _____
_____ _____ _____ _____ _____       _____ _____ _____            _____ _____ _____       TEAL_ SPRIN CORAL _____ _____
            >;

            layer-id = <NUMBERS>;
        };

        mouse {
            bindings = <
_____ _____ _____ _____ _____                                                            _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                WHITE ORANG BLUE_ ORANG _____ _____
_____ _____ _____ _____ _____ _____                                                WHITE BLUE_ BLUE_ BLUE_ _____ _____
_____ _____ _____ _____ _____ _____ _____ _____ _____            _____ _____ _____ _____ WHITE ORANG WHITE _____ _____
_____ _____ _____ _____ _____       _____ _____ _____            _____ _____ _____       _____ _____ _____ _____ _____
            >;

            layer-id = <MOUSE>;
        };

        mouse_slow {
            bindings = <
_____ _____ _____ _____ _____                                                            _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                WHITE ORANG TEAL_ ORANG _____ _____
_____ _____ _____ _____ _____ _____                                                WHITE TEAL_ TEAL_ TEAL_ _____ _____
_____ _____ _____ _____ _____ _____ _____ _____ _____            _____ _____ _____ _____ WHITE ORANG WHITE _____ _____
_____ _____ _____ _____ _____       _____ _____ _____            _____ _____ _____       _____ _____ _____ _____ _____
            >;

            layer-id = <MOUSESLOW>;
        };

        mouse_fast {
            bindings = <
_____ _____ _____ _____ _____                                                            _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                _____ _____ _____ _____ _____ _____
_____ _____ _____ _____ _____ _____                                                WHITE ORANG GREEN ORANG _____ _____
_____ _____ _____ _____ _____ _____                                                WHITE GREEN GREEN GREEN _____ _____
_____ _____ _____ _____ _____ _____ _____ _____ _____            _____ _____ _____ _____ WHITE ORANG WHITE _____ _____
_____ _____ _____ _____ _____       _____ _____ _____            _____ _____ _____       _____ _____ _____ _____ _____
            >;

            layer-id = <MOUSEFAST>;
        };
    };
};

/ {
    behaviors {
        // For the "layer" key, it'd nice to be able to use it as either a shift or a toggle.
        // Configure it as a tap dance, so the first tap (or hold) is a &mo and the second tap is a &to

        ComExcl: ComExcl {
            compatible = "zmk,behavior-mod-morph";
            label = "COMEXCL";
            bindings = <&kp COMMA>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        DotQues: DotQues {
            compatible = "zmk,behavior-mod-morph";
            label = "DOTQUES";
            bindings = <&kp PERIOD>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        LayerTap: LayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERTAP";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        Launchers3: Launchers3 {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHERS3";
            bindings = <&LeaderKey>, <&AlfredKey>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        Launchers2: Launchers2 {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHERS2";
            bindings = <&Launchers3>, <&RayCastKey>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
        };

        Launchers: Launchers {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHERS";
            bindings = <&Launchers2>, <&HammerspoonKey>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        Shortcuts: Shortcuts {
            compatible = "zmk,behavior-tap-dance";
            label = "SHORTCUTS";
            #binding-cells = <0>;
            bindings = <&mo 9>, <&mo 10>, <&mo 11>;
        };

        Content: Content {
            compatible = "zmk,behavior-tap-dance";
            label = "CONTENT";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&mo 5>;
        };

        Numbers: Numbers {
            compatible = "zmk,behavior-tap-dance";
            label = "NUMBERS";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        BackDelete: BackDelete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKDELETE";
            bindings = <&Backspace>, <&Delete>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        TapHold: TapHold {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPHOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        Delete: Delete {
            compatible = "zmk,behavior-mod-morph";
            label = "DELETE";
            bindings = <&TapHold LG(DELETE) DELETE>, <&kp LG(DELETE)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        Backspace: Backspace {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE";
            bindings = <&TapHold LG(BACKSPACE) BACKSPACE>, <&kp LG(BACKSPACE)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // Set mouse speed behavior (optional — you could also do this in mouse keymap entries directly)
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        WildCard: WildCard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F7))))>;
            label = "WILDCARD";
        };

        LeaderKey: LeaderKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(LC(COMMA)))>;
            label = "LEADERKEY";
        };

        AlfredKey: AlfredKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE)>;
            label = "ALFREDKEY";
        };

        RayCastKey: RayCastKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "RAYCASTKEY";
        };

        HammerspoonKey: Hammerspoon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(SPACE))>;
            label = "HAMMERSPOON";
        };
    };

    magic: magic_hold_tap {
        compatible = "zmk,behavior-hold-tap";
        label = "MAGIC_HOLD_TAP";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&rgb_ug_status_macro>;
    };

    /* Custom Defined Behaviors */
    /* Automatically generated keymap */

    combos { compatible = "zmk,combos"; };

    /*
    * KEYMAP
    */

    keymap {
        compatible = "zmk,keymap";

        Typing-Graphite {
            bindings = <
&kp F1       &kp F2    &kp F3     &kp F4          &kp F5                                                                                                                      &tog 13                &kp F7           &kp F8             &kp F9     &kp F10
&kp GRAVE    &kp BSLH  &kp LBKT   &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LESS_THAN                                                                       &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp SLASH  &kp MINUS
&kp TAB      &kp B     &kp L      &kp D           &kp W                 &kp Z                                                                               &kp K             &kp F                  &kp O            &kp U              &kp J      &kp TAB
&kp LSHFT    &kp N     &kp R      &kp T           &kp S                 &kp G                                                                               &kp Y             &kp H                  &kp A            &kp E              &kp I      &kp RIGHT_SHIFT
&kp ESC      &kp Q     &kp X      &kp M           &kp C                 &kp V          &kp SPACE  &kp TAB  &mo 6       &Content    &Numbers    &kp RSHFT    &kp SEMICOLON     &kp P                  &ComExcl         &DotQues           &kp SQT    &tog 13
&magic 12 0  &kp HOME  &kp LCTRL  &kp LEFT_ALT    &kp LEFT_COMMAND                     &kp ENTER  &mo 3    &kp ESCAPE  &Shortcuts  &Launchers  &BackDelete                    &kp RIGHT_COMMAND      &kp RIGHT_ALT    &kp RIGHT_CONTROL  &kp MINUS  &WildCard
            >;
        };

        Typing-QWERTY {
            bindings = <
&kp DEL  &kp BSPC  &trans  &trans  &trans                                                                  &trans  &trans     &trans   &trans    &trans
&trans   &kp N1    &kp N2  &kp N3  &kp N4  &kp N5                                                  &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB  &kp Q     &kp W   &kp E   &kp R   &kp T                                                   &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&trans   &kp A     &kp S   &kp D   &kp F   &kp G                                                   &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans   &kp Z     &kp X   &kp C   &kp V   &kp B   &trans  &trans  &trans  &trans  &trans  &trans  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans   &trans    &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans     &trans   &trans    &trans
            >;
        };

        Numbers {
            bindings = <
&trans  &trans                &trans                 &trans       &trans                                                                             &trans    &trans    &trans     &trans     &trans
&trans  &trans                &trans                 &trans       &trans     &trans                                                     &kp PERCENT  &kp FSLH  &kp STAR  &trans     &trans     &trans
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERIOD   &kp EQUAL  &kp COMMA                                                  &kp DOLLAR   &kp N7    &kp N8    &kp N9     &kp MINUS  &trans
&trans  &kp SLASH             &kp ASTERISK           &kp MINUS    &kp PLUS   &kp COLON                                                  &kp HASH     &kp N4    &kp N5    &kp N6     &kp PLUS   &trans
&trans  &trans                &kp DOLLAR             &kp PERCENT  &kp HASH   &trans     &trans  &trans  &trans  &trans  &trans  &trans  &kp COMMA    &kp N1    &kp N2    &kp N3     &kp EQUAL  &trans
&trans  &trans                &trans                 &trans       &trans                &trans  &trans  &trans  &trans  &trans  &trans               &kp N0    &kp DOT   &kp EQUAL  &trans     &trans
            >;
