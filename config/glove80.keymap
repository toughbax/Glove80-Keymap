/***********
 * 6. Behaviours
*********************/

/ {
    behaviors {
        /* 6a. Keypairs */

        ComExcl: ComExcl {
            compatible = "zmk,behavior-mod-morph";
            label = "COMEXCL";
            bindings = <&kp COMMA>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        DotQues: DotQues {
            compatible = "zmk,behavior-mod-morph";
            label = "DOTQUES";
            bindings = <&kp PERIOD>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        /* 6b. Quick Launchers */

        LaunchMouseMap: LaunchMouseMap {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHMOUSEMAP";
            bindings = <&LaunchRaycast>, <&MouseMapKey>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL)>;
        };

        LaunchRaycast: LaunchRaycast {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHRAYCAST";
            bindings = <&LaunchAlfred>, <&RayCastKey>;

            #binding-cells = <0>;
            mods = <(MOD_RALT)>;
        };

        LaunchAlfred: LaunchAlfred {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHERS4";
            bindings = <&LeaderKey>, <&AlfredKey>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI)>;
        };

        /* 6c. Layer Toggle Keys **/

        Shortcuts: Shortcuts {
            compatible = "zmk,behavior-tap-dance";
            label = "SHORTCUTS";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(LEFT_SHIFT)))>, <&mo 8>, <&mo 9>;

            tapping-term-ms = <400>;
        };

        Content: Content {
            compatible = "zmk,behavior-tap-dance";
            label = "CONTENT";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&mo 5>;
        };

        Numbers: Numbers {
            compatible = "zmk,behavior-tap-dance";
            label = "NUMBERS";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        /* 6d. Delete Backspace Functionality */

        BackDelete: BackDelete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKDELETE";
            bindings = <&Backspace>, <&Delete>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        Delete: Delete {
            compatible = "zmk,behavior-mod-morph";
            label = "DELETE";
            bindings = <&TapHold LA(DELETE) DELETE>, <&kp LG(DELETE)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        Backspace: Backspace {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE";
            bindings = <&TapHold LA(BACKSPACE) BACKSPACE>, <&kp LG(BACKSPACE)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        /* 6e. Internal Helpers */

        TapHold: TapHold {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPHOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        LayerTap: LayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERTAP";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        /* 6d. Magic Layer/Core */

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        KeyBrackets: KeyBrackets {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYBRACKETS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeyBrace: KeyBrace {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYBRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeyCompare: KeyCompare {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYCOMPARE";
            bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeySlash: KeySlash {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYSLASH";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeySquare: KeySquare {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYSQUARE";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        Mouse: Mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "MOUSE";
            #binding-cells = <0>;
            bindings = <&mo 6>, <&tog 6>;
        };

        Symbols: Symbols {
            compatible = "zmk,behavior-tap-dance";
            label = "SYMBOLS";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&tog 3>;
        };
    };
};

/***********
* 7. macros
*********************/

/ {
    macros {
        /* 7a. Glove80 Core */

        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        /* 7b. Shortcut Keys */

        LeaderKey: LeaderKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(LC(COMMA)))>;
            label = "LEADERKEY";
        };

        AlfredKey: AlfredKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE)>;
            label = "ALFREDKEY";
        };

        RayCastKey: RayCastKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "RAYCASTKEY";
        };

        MouseMapKey: MouseMapKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(SPACE)))>;
            label = "MOUSEMAPKEY";
        };

        Launchers: Launchers {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&LaunchMouseMap>;
            label = "LAUNCHERS";
        };

        Wildcard: Wildcard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F1))))>;
            label = "WILDCARD";
        };

        Wildcard2: Wildcard2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F2))))>;
            label = "WILDCARD2";
        };

        Wildcard3: Wildcard3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F3))))>;
            label = "WILDCARD3";
        };

        Wildcard4: Wildcard4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F4))))>;
            label = "WILDCARD4";
        };

        Wildcard5: Wildcard5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F5))))>;
            label = "WILDCARD5";
        };

        Wildcard6: Wildcard6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F6))))>;
            label = "WILDCARD6";
        };
    };
};

/***********
* 8. Combos
*********************/

/ {
    combos { compatible = "zmk,combos"; };
};

/***********
* 9. Keymaps
*********************/

/ {
    keymap {
        compatible = "zmk,keymap";

        Typing-Graphite {
            bindings = <
&kp F1       &kp F2          &Wildcard   &Wildcard2    &Wildcard3                                                                                                          &Wildcard4         &Wildcard5     &Wildcard6         &kp F9           &kp F10
&kp GRAVE    &KeySlash       &KeySquare  &KeyBrace     &KeyBrackets      &KeyCompare                                                                        &kp MINUS      &kp GRAVE          &kp SQT        &kp EQUAL          &kp PIPE         &none
&caps_word   &kp B           &kp L       &kp D         &kp W             &kp Z                                                                              &kp K          &kp F              &kp O          &kp U              &kp J            &none
&kp LSHFT    &kp N           &kp R       &kp T         &kp S             &kp G                                                                              &kp Y          &kp H              &kp A          &kp E              &kp I            &kp RIGHT_SHIFT
&none        &kp Q           &kp X       &kp M         &kp C             &kp V        &kp SPACE  &kp TAB   &Mouse      &Content    &Numbers    &kp RSHFT    &kp SEMICOLON  &kp P              &ComExcl       &DotQues           &KeySlash        &none
&magic 10 0  &kp LEFT_SHIFT  &kp LCTRL   &kp LEFT_ALT  &kp LEFT_COMMAND               &kp ENTER  &Symbols  &kp ESCAPE  &Shortcuts  &Launchers  &BackDelete                 &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &none
            >;
        };

        Typing-QWERTY {
            bindings = <
&kp DEL  &kp BSPC  &trans  &trans  &trans                                                                  &trans  &trans     &trans   &trans    &trans
&trans   &kp N1    &kp N2  &kp N3  &kp N4  &kp N5                                                  &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB  &kp Q     &kp W   &kp E   &kp R   &kp T                                                   &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&trans   &kp A     &kp S   &kp D   &kp F   &kp G                                                   &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans   &kp Z     &kp X   &kp C   &kp V   &kp B   &trans  &trans  &trans  &trans  &trans  &trans  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans   &trans    &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans     &trans   &trans    &trans
            >;
        };

        Numbers {
            bindings = <
&trans  &trans                &trans                 &trans       &trans                                                                             &trans    &trans    &trans     &trans     &trans
&trans  &trans                &trans                 &trans       &trans     &trans                                                     &kp PERCENT  &kp FSLH  &kp STAR  &trans     &trans     &trans
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERIOD   &kp EQUAL  &kp COMMA                                                  &kp DOLLAR   &kp N7    &kp N8    &kp N9     &kp MINUS  &trans
