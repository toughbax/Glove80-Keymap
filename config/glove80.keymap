/***********
 * 7. Behaviours
*********************/

/ {
    behaviors {
        /*****
    /* 7a. Keypairs
    /**********/

        Dot_Exlcaim: Dot_Exlcaim {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_EXLCAIM";
            bindings = <&kp PERIOD>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        Com_Ques: Com_Ques {
            compatible = "zmk,behavior-mod-morph";
            label = "COM_QUES";
            bindings = <&kp COMMA>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeyBrackets: KeyBrackets {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYBRACKETS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeyBrace: KeyBrace {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYBRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeyCompare: KeyCompare {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYCOMPARE";
            bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeySlash: KeySlash {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYSLASH";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        KeySquare: KeySquare {
            compatible = "zmk,behavior-mod-morph";
            label = "KEYSQUARE";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        /*****
    /* 7b. Quick Launchers
    /*************/

        Launch1Pass: Launch1Pass {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCH1PASS";
            bindings = <&LaunchShortCat>, <&OnePassKey>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        LaunchRaycast: LaunchRaycast {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHRAYCAST";
            bindings = <&LaunchAlfred>, <&RayCastKey>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI|MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        LaunchAlfred: LaunchAlfred {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHERS4";
            bindings = <&LeaderKey>, <&AlfredKey>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        /*****
    /* 7c. Layer Toggle Keys
    /*************/

        Shortcuts: Shortcuts {
            compatible = "zmk,behavior-tap-dance";
            label = "SHORTCUTS";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(LEFT_ALT))>, <&mo 9>, <&mo 10>;

            tapping-term-ms = <400>;
        };

        Content: Content {
            compatible = "zmk,behavior-tap-dance";
            label = "CONTENT";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&mo 5>;
        };

        Numbers: Numbers {
            compatible = "zmk,behavior-tap-dance";
            label = "NUMBERS";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        Symbols: Symbols {
            compatible = "zmk,behavior-tap-dance";
            label = "SYMBOLS";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&tog 3>;
        };

        /******
    /* 7d. Delete Backspace Functionality 
    /*************/

        BackDelete: BackDelete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKDELETE";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        /******
    /* 7e. Internal Helpers
    /*************/

        TapHold: TapHold {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPHOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        LayerTap: LayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERTAP";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        /******
    /* 7f. Magic Layer/Core
    /*************/

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        Mouse: Mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE";
            bindings = <&mo>, <&MouseUtil>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };

        /******
    * 7g. Content Control
    *************/
        // SELECT_WORD_DELAY defines how long the macro waits (milliseconds)
        // after moving the cursor before it selects a word. A larger delay
        // may allow the macro to move to the next word upon each invocation.
        //

        #ifndef SELECT_WORD_DELAY
        #define SELECT_WORD_DELAY 1
        #endif

        #define select_all &kp LC(A)

        // Select None Macro

        select_none: select_none {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "SELECT_NONE";
            bindings = <&kp DOWN &kp UP &kp RIGHT &kp LEFT>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Select a word (jumps to the next word upon each successive invocation)

        select_word: select_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&select_word_right>, <&select_word_left>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // Move Right and Select a Word

        select_word_right: select_word_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "SELECT_WORD_RIGHT";
            bindings = <&kp LG(RIGHT) &kp LG(LEFT) &kp LS(LG(RIGHT))>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Move Left and Select a Word

        select_word_left: select_word_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "SELECT_WORD_LEFT";
            bindings = <&kp LG(LEFT) &kp LG(RIGHT) &kp LS(LG(LEFT))>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Extend current selection by one word

        extend_word: extend_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&extend_word_right>, <&extend_word_left>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // Extend selection to the right by one word

        extend_word_right: extend_word_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EXTEND_WORD_RIGHT";
            bindings = <&kp LS(LG(RIGHT))>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Extend selection to the left by one word

        extend_word_left: extend_word_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EXTEND_WORD_LEFT";
            bindings = <&kp LS(LG(LEFT))>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Select the entire line

        select_line: select_line {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&select_line_right>, <&select_line_left>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        // Select the current line (move cursor to start and then select)

        select_line_right: select_line_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "SELECT_LINE_RIGHT";
            bindings = <&kp HOME &kp LS(END)>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Select the current line (move cursor to end and then select backward)

        select_line_left: select_line_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "SELECT_LINE_LEFT";
            bindings = <&kp END &kp LS(HOME)>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Extend selection to the next line

        extend_line: extend_line {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&extend_line_right>, <&extend_line_left>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        LaunchShortCat: LaunchShortCat {
            compatible = "zmk,behavior-mod-morph";
            label = "LAUNCHSHORTCAT";
            bindings = <&LaunchRaycast>, <&ShortCatKey>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
        };

        MouseUtil: MouseUtil {
            compatible = "zmk,behavior-mod-morph";
            label = "MOUSEUTIL";
            bindings = <&MouseMapKey>, <&ShortCatKey>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RSFT|MOD_RGUI)>;
        };

        // Extend selection to the next line downward

        extend_line_right: extend_line_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EXTEND_LINE_RIGHT";
            bindings = <&kp LS(DOWN) &kp LS(END)>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };

        // Extend selection to the previous line upward

        extend_line_left: extend_line_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EXTEND_LINE_LEFT";
            bindings = <&kp LS(UP) &kp LS(HOME)>;
            wait-ms = <SELECT_WORD_DELAY>;
            tap-ms = <SELECT_WORD_DELAY>;
        };
    };
};

/***********
* 8. macros
*********************/

/ {
    macros {
        /******
    /* 8a. Glove80 Core
    /*************/

        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        /******
    /* 8b. Shortcut Keys
    /*************/

        LeaderKey: LeaderKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(LC(COMMA)))>;
            label = "LEADERKEY";
        };

        AlfredKey: AlfredKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE)>;
            label = "ALFREDKEY";
        };

        RayCastKey: RayCastKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "RAYCASTKEY";
        };

        MouseMapKey: MouseMapKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(SPACE)))>;
            label = "MOUSEMAPKEY";
        };

        Launchers: Launchers {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&Launch1Pass>;
            label = "LAUNCHERS";
        };

        /*********
    /* 8c. Wilds
    /*************/

        Wild1: Wild1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(NUMBER_1))>;
            label = "WILD";
        };

        Wild2: Wild2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(NUMBER_2))>;
            label = "WILD2";
        };

        Wild3: Wild3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(NUMBER_3))>;
            label = "WILD3";
        };

        Wild4: Wild4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(NUMBER_4))>;
            label = "WILD4";
        };

        Wild5: Wild5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(NUMBER_5))>;
            label = "WILD5";
        };

        Wild6: Wild6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(NUMBER_6))>;
            label = "WILD6";
        };

        MousLessClick: MousLessClick {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "MOUSLESSCLICK";
        };

        ShortCatKey: ShortCatKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(SLASH)))>;
            label = "SHORTCATKEY";
        };

        OnePassKey: OnePassKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(PERIOD)>;
            label = "ONEPASSKEY";
        };
    };
};

/***********
* 9. Combos
*********************/

/ {
    combos {
        compatible = "zmk,combos";

        QuickEscape {
            bindings = <&kp ESCAPE>;
            key-positions = <54 55>;
        };

        SymbolsLayer {
            bindings = <&mo 3>;
            key-positions = <56 57>;
        };
    };
};

