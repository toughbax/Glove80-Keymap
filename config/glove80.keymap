/* Custom Device-tree */

#include <dt-bindings/zmk/rgb_colors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define NUMBERS 1
#define SYMBOLS 2
#define NVIM 11

/*
 *    RGB MAPS
*/
/* Custom Device-tree */
/* Empty underglow layer definition (for copy-paste)
        mylayer {
            bindings = <
                &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                                  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                &ug ___ &ug ___ &ug ___ &ug ___ &ug ___         &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___         &ug ___ &ug ___ &ug ___ &ug ___ &ug ___
                >;
            layer-id = <LAYER_Name>;
        };
*/

/ {
    underglow-layer {
        compatible = "zmk,underglow-layer";

        vim {
            bindings = <
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                                  &ug BLUE &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___         &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___         &ug ___  &ug ___ &ug ___ &ug ___ &ug ___
            >;

            layer-id = <NUMBERS>;
        };

        numbers {
            bindings = <
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                                  &ug ___  &ug ___   &ug ___   &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug ___  &ug ___   &ug ___   &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug BLUE &ug BLUE  &ug BLUE  &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___                                                  &ug ___ &ug BLUE &ug BLUE  &ug BLUE  &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___ &ug ___ &ug BLUE &ug BLUE  &ug BLUE  &ug ___ &ug ___
    &ug ___ &ug ___ &ug ___ &ug ___ &ug ___         &ug ___ &ug ___ &ug ___  &ug ___ &ug ___ &ug ___         &ug BLUE &ug GREEN &ug GREEN &ug ___ &ug ___
            >;

            layer-id = <NVIM>;
        };
    };
};

/ {
    behaviors {
        // For the "layer" key, it'd nice to be able to use it as either a shift or a toggle.
        // Configure it as a tap dance, so the first tap (or hold) is a &mo and the second tap is a &to

        ComExcl: ComExcl {
            compatible = "zmk,behavior-mod-morph";
            label = "COMEXCL";
            bindings = <&kp COMMA>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        DotQues: DotQues {
            compatible = "zmk,behavior-mod-morph";
            label = "DOTQUES";
            bindings = <&kp PERIOD>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        LayerTap: LayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERTAP";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        LeaderAlfred: LeaderAlfred {
            compatible = "zmk,behavior-mod-morph";
            label = "LEADERALFRED";
            bindings = <&LeaderKey>, <&AlfredKey>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        LeaderRaycast: LeaderRaycast {
            compatible = "zmk,behavior-mod-morph";
            label = "LEADERRAYCAST";
            bindings = <&LeaderKey>, <&RayCastKey>;

            #binding-cells = <0>;
            mods = <(MOD_RALT|MOD_LALT)>;
        };

        LeaderHammerspoon: LeaderHammerspoon {
            compatible = "zmk,behavior-mod-morph";
            label = "LEADERHAMMERSPOON";
            bindings = <&LeaderKey>, <&HammerspoonKey>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        // Set mouse speed behavior (optional — you could also do this in mouse keymap entries directly)
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        WildCard: WildCard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(LA(LC(F7))))>;
            label = "WILDCARD";
        };

        LeaderKey: LeaderKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(LC(COMMA)))>;
            label = "LEADERKEY";
        };

        AlfredKey: AlfredKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE)>;
            label = "ALFREDKEY";
        };

        RayCastKey: RayCastKey {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "RAYCASTKEY";
        };

        HammerspoonKey: Hammerspoon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(SPACE))>;
            label = "HAMMERSPOON";
        };

        Launchers: Launchers {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&LeaderAlfred &LeaderRaycast &LeaderHammerspoon>;
            label = "LAUNCHERS";
        };
    };

    magic: magic_hold_tap {
        compatible = "zmk,behavior-hold-tap";
        label = "MAGIC_HOLD_TAP";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&rgb_ug_status_macro>;
    };

    /* Custom Defined Behaviors */
    /* Automatically generated keymap */

    combos { compatible = "zmk,combos"; };

    /*
    * KEYMAP
    */

    keymap {
        compatible = "zmk,keymap";

        Typing-Graphite {
            bindings = <
&kp F1       &kp F2    &kp F3     &kp F4          &kp F5                                                                                                                                 &tog 13                &kp F7           &kp F8             &kp F9     &kp F10
&kp GRAVE    &kp BSLH  &kp LBKT   &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LESS_THAN                                                                                  &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp SLASH  &kp MINUS
&kp TAB      &kp B     &kp L      &kp D           &kp W                 &kp Z                                                                                          &kp K             &kp F                  &kp O            &kp U              &kp J      &kp TAB
&kp LSHFT    &kp N     &kp R      &kp T           &kp S                 &kp G                                                                                          &kp Y             &kp H                  &kp A            &kp E              &kp I      &kp RIGHT_SHIFT
&kp ESC      &kp Q     &kp X      &kp M           &kp C                 &kp V          &kp SPACE  &kp TAB  &mo 6       &mo 4  &mo 2       &kp RSHFT                    &kp SEMICOLON     &kp P                  &ComExcl         &DotQues           &kp SQT    &tog 13
&magic 12 0  &kp HOME  &kp LCTRL  &kp LEFT_ALT    &kp LEFT_COMMAND                     &kp ENTER  &mo 3    &kp ESCAPE  &mo 9  &Launchers  &mt BACKSPACE LC(BACKSPACE)                    &kp RIGHT_COMMAND      &kp RIGHT_ALT    &kp RIGHT_CONTROL  &kp MINUS  &WildCard
            >;
        };

        Typing-QWERTY {
            bindings = <
&kp DEL  &kp BSPC  &trans  &trans  &trans                                                                  &trans  &trans     &trans   &trans    &trans
&trans   &kp N1    &kp N2  &kp N3  &kp N4  &kp N5                                                  &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB  &kp Q     &kp W   &kp E   &kp R   &kp T                                                   &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&trans   &kp A     &kp S   &kp D   &kp F   &kp G                                                   &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans   &kp Z     &kp X   &kp C   &kp V   &kp B   &trans  &trans  &trans  &trans  &trans  &trans  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
&trans   &trans    &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans     &trans   &trans    &trans
            >;
        };

        Numbers {
            bindings = <
&trans  &trans                &trans                 &trans       &trans                                                                             &trans    &trans    &trans     &trans     &trans
&trans  &trans                &trans                 &trans       &trans     &trans                                                     &kp PERCENT  &kp FSLH  &kp STAR  &trans     &trans     &trans
&trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERIOD   &kp EQUAL  &kp COMMA                                                  &kp DOLLAR   &kp N7    &kp N8    &kp N9     &kp COLON  &trans
&trans  &kp SLASH             &kp ASTERISK           &kp MINUS    &kp PLUS   &kp COLON                                                  &kp HASH     &kp N4    &kp N5    &kp N6     &kp PLUS   &trans
&trans  &trans                &kp DOLLAR             &kp PERCENT  &kp HASH   &trans     &trans  &trans  &trans  &trans  &trans  &trans  &kp COMMA    &kp N1    &kp N2    &kp N3     &kp EQUAL  &trans
&trans  &trans                &trans                 &trans       &trans                &trans  &trans  &trans  &trans  &trans  &trans               &kp N0    &kp DOT   &kp EQUAL  &trans     &trans
            >;
        };

        Symbols {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Content-Cursor {
            bindings = <
&trans  &trans  &trans     &trans      &trans                                                                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans      &trans       &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans      &trans       &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans      &trans       &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans      &trans               &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Content-NVIM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp X   &kp Y   &kp P   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Mouse {
            bindings = <
&none  &none      &none     &none     &none                                                                                &none             &none              &none              &none  &none
&none  &none      &none     &none     &none      &none                                                     &none           &none             &none              &none              &none  &none
&none  &none      &none     &kp UP    &none      &kp PAGE_UP                                               &msc SCRL_UP    &none             &mmv MOVE_Y(400)   &none              &none  &none
&none  &kp EQUAL  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN                                             &msc SCRL_DOWN  &mmv MOVE_X(400)  &mmv MOVE_Y(-400)  &mmv MOVE_X(-400)  &none  &none
&none  &none      &none     &none     &none      &none          &trans  &none  &none  &none  &none  &none  &none           &mkp LCLK         &mkp MCLK          &mkp RCLK          &none  &none
&none  &none      &trans    &trans    &trans                    &trans  &none  &none  &none  &none  &none                  &none             &none              &none              &none  &none
            >;
        };

        Mouse-Fast {
            bindings = <
&trans  &trans     &trans    &trans    &trans                                                                                    &trans            &trans             &trans             &trans  &trans
&trans  &trans     &trans    &trans    &trans     &trans                                                         &trans          &trans            &trans             &trans             &trans  &trans
&trans  &trans     &trans    &kp UP    &trans     &kp PAGE_UP                                                    &msc SCRL_UP    &trans            &mmv MOVE_Y(-600)  &trans             &trans  &trans
&trans  &kp EQUAL  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN                                                  &msc SCRL_DOWN  &mmv MOVE_X(600)  &mmv MOVE_Y(-600)  &mmv MOVE_X(-600)  &trans  &trans
&trans  &trans     &trans    &trans    &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans          &mkp LCLK         &mkp MCLK          &mkp RCLK          &trans  &trans
&trans  &trans     &trans    &trans    &trans                    &trans  &trans  &trans  &trans  &trans  &trans                  &trans            &trans             &trans             &trans  &trans
            >;
        };

        Mouse-Slow {
            bindings = <
&trans  &trans     &trans    &trans    &trans                                                                                    &trans            &trans             &trans             &trans  &trans
&trans  &trans     &trans    &trans    &trans     &trans                                                         &trans          &trans            &trans             &trans             &trans  &trans
&trans  &trans     &trans    &kp UP    &trans     &kp PAGE_UP                                                    &msc SCRL_UP    &trans            &mmv MOVE_Y(200)   &trans             &trans  &trans
&trans  &kp EQUAL  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN                                                  &msc SCRL_DOWN  &mmv MOVE_X(200)  &mmv MOVE_Y(-200)  &mmv MOVE_X(-200)  &trans  &trans
&trans  &trans     &trans    &trans    &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans          &mkp LCLK         &mkp MCLK          &mkp RCLK          &trans  &trans
&trans  &trans     &trans    &trans    &trans                    &trans  &trans  &trans  &trans  &trans  &trans                  &trans            &trans             &trans             &trans  &trans
            >;
        };

        Shortcuts {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Shortcuts2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        System {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                           &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none            &kp PAUSE_BREAK
&trans        &none         &none           &none           &none            &kp HOME                                                   &kp LEFT_PARENTHESIS   &kp KP_NUM  &kp KP_EQUAL  &kp KP_SLASH  &kp KP_MULTIPLY  &kp PRINTSCREEN
&trans        &none         &none           &kp UP_ARROW    &none            &kp END                                                    &kp RIGHT_PARENTHESIS  &kp KP_N7   &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &kp SCROLLLOCK
&trans        &none         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PG_UP                                                  &kp PERCENT            &kp KP_N4   &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &none
&trans        &kp K_APP     &none           &kp F11         &kp F12          &kp PG_DN  &trans  &trans  &to 0   &trans  &trans  &trans  &kp COMMA              &kp KP_N1   &kp KP_N2     &kp KP_N3     &kp KP_ENTER     &trans
&magic 0 0    &kp CAPS      &kp INS         &kp F11         &kp F12                     &trans  &trans  &trans  &trans  &trans  &trans                         &kp KP_N0   &kp KP_N0     &kp KP_DOT    &kp KP_ENTER     &trans
            >;
        };

        Magic {
            bindings = <
&bt BT_CLR   &none            &none            &none            &none                                                                                     &none  &none  &none  &none  &bt BT_CLR_ALL
&none        &none            &none            &none            &none            &none                                                             &none  &none  &none  &none  &none  &none
&trans       &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                   &none  &none  &none  &none  &none  &none
&bootloader  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                   &none  &none  &none  &none  &none  &bootloader
&sys_reset   &none            &none            &none            &none            &none            &bt_2  &bt_3  &none         &none  &none  &none  &none  &none  &none  &none  &none  &sys_reset
&none        &none            &none            &none            &none                             &bt_0  &bt_1  &out OUT_USB  &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };

        NVIM_FLAG {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        NVIM_Content {
            if-layers = <4 13>;
            then-layer = <5>;
        };
    };
};
