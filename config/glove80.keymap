/*
 * Glove 80 Keymap
 *
 * Contents:
 * 1. Includes
 * 2. Layer Defninitons
 * 3. Color Definitions
 * 4. Layer Colors
 * 5. Color Maps
 * 6. Behaviours
 * 7. macros
 * 8. Combos
 * 9. Keymaps
 *
 */
/***********
*  1. Includes
*********************/

#include <dt-bindings/zmk/rgb_colors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/***********
*  2. Layer Defninitons
*********************/

#define DEFAULT      0
#define QWERTY       1
#define NUMBERS      2
#define SYMBOLS      3
#define CONTENT      4
#define NVIM         5
#define MOUSE        6
#define MOUSE_FAST   7
#define MOUSE_SLOW   8
#define SHORTCUTS    9
#define SHORTCUTS_2 10
#define SYSTEM      11
#define MAGIC       12

/***********
* 3. Color Definitions
*********************/

#define COLOR_WHITE        0xFFFFFF
#define COLOR_SKY_BLUE     0x66B3FF
#define COLOR_DEEP_BLUE    0x005F99
#define COLOR_LIGHT_BLUE   0x80CFFF
#define COLOR_BRIGHT_GREEN 0x00E673
#define COLOR_ORANGE       0xFF9933
#define COLOR_PURPLE       0x9900FF
#define COLOR_DEEP_PURPLE  0x0900FF
#define COLOR_DARK_RED     0xB30000
#define COLOR_GOLD         0xC49A21
#define COLOR_DEEP_TEAL    0x005F73

/***********
* 4. Layer Colors
*********************/

#define ______  &ug BLACK
#define _DFLT_  &ug BLACK
#define _QWTY_  &ug COLOR_WHITE
#define _NMBR_  &ug COLOR_SKY_BLUE
#define _SYMB_  &ug COLOR_DEEP_BLUE
#define _CONT_  &ug COLOR_ORANGE
#define _NVIM_  &ug COLOR_PURPLE
#define _MSE__  &ug COLOR_BRIGHT_GREEN
#define _MSEF_  &ug COLOR_BRIGHT_GREEN
#define _MSES_  &ug COLOR_BRIGHT_GREEN
#define _HLP__  &ug COLOR_DEEP_TEAL
#define _HLP2_  &ug COLOR_DEEP_TEAL
#define _SYST_  &ug COLOR_DARK_RED
#define _MAGC_  &ug COLOR_GOLD

/***********
 * 5. Color Maps
*********************/
